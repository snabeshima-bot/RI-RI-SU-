# --- 認証 (Auth.js) ---
# `npx auth secret` などで生成
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# ログインを許可するGoogle Workspaceドメイン
ALLOWED_DOMAIN=focpro.co.jp

# --- データベース (Vercel Marketplace の Neon を接続すると自動設定) ---
DATABASE_URL=

# --- アプリURL (メール内リンク用) ---
APP_URL=https://your-app.vercel.app

# --- メール (Resend) ---
RESEND_API_KEY=
MAIL_FROM="リリース管理 <noreply@focpro.co.jp>"

# --- Googleカレンダー (サービスアカウント) ---
# サービスアカウントのJSONキーを1行で貼り付け
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# --- Vercel Cron (Vercelが自動で Authorization ヘッダーに付与) ---
CRON_SECRET=
